{
  "compilerOptions": {
    "outDir": "dist",          // compiled JS goes here
    "rootDir": "src",          // your source code lives here
    "module": "commonjs",      // Node.js module system
    "target": "es2019",        // modern JS output
    "strict": true,            // enable all strict type checks
    "esModuleInterop": true,   // allow default imports from CommonJS
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
"types": ["node"]
  },
  "include": ["src"],          // only compile files in src/
  "exclude": ["node_modules"]  // ignore dependencies
}


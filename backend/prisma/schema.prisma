generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  phone        String?
  passwordHash String
  accountType  String   @default("viewer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

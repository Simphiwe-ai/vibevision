{
  "name": "backend",
  "version": "1.0.0",
  "scripts": {
    "prepare": "husky",
    "dev": "tsx watch src/server.ts",
    "start": "npm run build && node dist/server.js",
    "build": "tsc",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "format": "prettier --write 'src/**/*.{ts,js,json,md}'",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
